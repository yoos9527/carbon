<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.carbon</groupId>
    <artifactId>carbon</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>carbon</name>
    <description>连接器平台：页面配置三方服务 → 沉淀可复用连接器/接口 → 业务侧按名称调用</description>

    <modules>
        <module>carbon-common</module>
        <module>carbon-framework</module>
        <module>carbon-modules</module>
        <module>carbon-admin</module>
    </modules>

    <properties>
        <revision>1.0.0</revision>

        <!-- 编译目标 -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 环境：local | dev | prod（被 carbon-admin 的资源过滤取用） -->
        <profiles.active>local</profiles.active>

        <!-- 三方依赖版本：全部集中在此，禁止在子模块里写 version -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <redisson.version>3.52.0</redisson.version>
        <springdoc.version>2.8.17</springdoc.version>
        <mapstruct-plus.version>1.5.3</mapstruct-plus.version>

        <!-- framework 自研二方包用到的底层库 -->
        <httpclient5.version>5.6.5</httpclient5.version>
        <groovy.version>4.0.33</groovy.version>
        <aviator.version>5.4.4</aviator.version>
        <jsonpath.version>2.10.0</jsonpath.version>
        <liteflow.version>2.16.3</liteflow.version>

        <!-- 构建插件版本 -->
        <lombok.version>1.18.48</lombok.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.4</maven-failsafe-plugin.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 官方 BOM：统一管理 spring-*、jackson、junit、testcontainers、flyway 等 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus BOM -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 本项目公共模块（显式声明，不用 BOM import：BOM 的 parent 是本工程，会构成 import 循环） -->
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-core</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-web</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-mybatis</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-redis</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-json</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-doc</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-encrypt</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-sensitive</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-log</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-sse</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-common-idempotent</artifactId>
                <version>1.0.0</version>
            </dependency>

            <!-- framework：业务无关的二方包 -->
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-framework-expression</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-framework-http</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-framework-script</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-framework-dag</artifactId>
                <version>1.0.0</version>
            </dependency>

            <!-- modules：业务域 -->
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-system</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-connector</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-engine</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-gateway</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-invokelog</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-flow</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.carbon</groupId>
                <artifactId>carbon-job</artifactId>
                <version>1.0.0</version>
            </dependency>

            <!-- 三方库：framework 用 -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy-json</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.aviator</groupId>
                <artifactId>aviator</artifactId>
                <version>${aviator.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jayway.jsonpath</groupId>
                <artifactId>json-path</artifactId>
                <version>${jsonpath.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-core</artifactId>
                <version>${liteflow.version}</version>
            </dependency>

            <!-- 三方库：common 用 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.linpeilie</groupId>
                <artifactId>mapstruct-plus-spring-boot-starter</artifactId>
                <version>${mapstruct-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.linpeilie</groupId>
                <artifactId>mapstruct-plus-processor</artifactId>
                <version>${mapstruct-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全项目统一：Lombok 与 SLF4J 门面 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial,-fallthrough</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <profiles.active>local</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>dev</id>
            <properties>
                <profiles.active>dev</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
            </properties>
        </profile>
    </profiles>
</project>
