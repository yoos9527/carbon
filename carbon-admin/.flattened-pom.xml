<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.carbon</groupId>
        <artifactId>carbon</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>carbon-admin</artifactId>
    <packaging>jar</packaging>

    <name>carbon-admin</name>
    <description>唯一可执行模块：装配所有业务模块并启动（不写业务逻辑）。</description>

    <dependencies>
        <!-- 基础设施 -->
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-common-doc</artifactId>
        </dependency>

        <!-- 业务域 -->
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-connector</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-invokelog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-flow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.carbon</groupId>
            <artifactId>carbon-job</artifactId>
        </dependency>

        <!-- 运维 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>carbon-admin</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/*.yml</include>
                    <include>**/*.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.yml</exclude>
                    <exclude>**/*.yaml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.carbon.CarbonApplication</mainClass>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
